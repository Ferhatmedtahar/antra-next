{
  "name": "antra",
  "version": "0.1.0",
  "description": "AST-based static analysis security linter for React Server Components and the Next.js App Router.",
  "keywords": [
    "nextjs",
    "react-server-components",
    "security",
    "static-analysis",
    "linter",
    "taint-analysis",
    "prisma",
    "supabase",
    "sarif"
  ],
  "homepage": "https://github.com/Ferhatmedtahar/Antra#readme",
  "bugs": {
    "url": "https://github.com/Ferhatmedtahar/Antra/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Ferhatmedtahar/Antra.git"
  },
  "author": "Ferhat Mohamed Tahar",
  "type": "module",
  "license": "MIT",
  "bin": {
    "antra": "./bin/antra.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "bin"
  ],
  "engines": {
    "node": ">=20"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "11.24.0",
      "onFail": "download"
    }
  },
  "packageManager": "pnpm@11.24.0",
  "scripts": {
    "dev": "tsx src/cli/index.ts",
    "build": "tsup && pnpm --filter studio build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit && pnpm --filter studio typecheck",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky",
    "commit": "cz",
    "build:cli": "tsup",
    "build:studio": "pnpm --filter studio build",
    "dev:studio": "pnpm --filter studio dev",
    "prepublishOnly": "pnpm build"
  },
  "config": {
    "commitizen": {
      "path": "cz-conventional-changelog"
    }
  },
  "dependencies": {
    "@hono/node-server": "^2.1.1",
    "@inquirer/prompts": "^8.7.1",
    "better-sqlite3": "^12.4.1",
    "chalk": "^6.0.0",
    "commander": "^15.0.0",
    "hono": "^4.13.5",
    "ora": "^9.4.1",
    "ts-morph": "^28.0.0",
    "yaml": "^2.9.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.4.3",
    "@commitlint/config-conventional": "^20.4.3",
    "@fontsource/poppins": "^5.3.0",
    "@tabler/icons-react": "^3.46.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^26.4.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "commitizen": "^4.3.1",
    "cz-conventional-changelog": "^3.3.0",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "lint-staged": "^16.3.2",
    "prettier": "^3.8.1",
    "radix-ui": "^1.6.7",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "tsup": "^8.5.1",
    "tsx": "^4.23.13",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.4",
    "vite": "^8.2.2",
    "vitest": "^4.1.11",
    "wouter": "^3.10.0"
  }
}
